    },
    "Auth Validate": {
      "main": [[{ "node": "GET OPEN Escalations", "type": "main", "index": 0 }]]
    },
    "GET OPEN Escalations": {
      "main": [[{ "node": "Check Escalations Exist", "type": "main", "index": 0 }]]
    },
    "Check Escalations Exist": {
      "main": [
        [{ "node": "Split Escalations", "type": "main", "index": 0 }],
        [{ "node": "Output Summary", "type": "main", "index": 0 }]
      ]
    },
    "Split Escalations": {
      "main": [[{ "node": "GET Conversation Context", "type": "main", "index": 0 }]]
    },
    "GET Conversation Context": {
      "main": [[{ "node": "Format Email", "type": "main", "index": 0 }]]
    },
    "Format Email": {
      "main": [[{ "node": "Send Email via SMTP", "type": "main", "index": 0 }]]
    },
    "Send Email via SMTP": {
      "main": [[{ "node": "Pass Escalation ID", "type": "main", "index": 0 }]]
    },
    "Pass Escalation ID": {
      "main": [[{ "node": "PATCH Mark Notified", "type": "main", "index": 0 }]]
    },
    "PATCH Mark Notified": {
      "main": [[{ "node": "Output Summary", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "sequential" },
