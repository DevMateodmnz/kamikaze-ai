      "parameters": {
        "mode": "json",
        "assignments": {
          "assignments": [
            {
              "id": "content-field",
              "name": "content",
              "value": "=\n\ud83d\udea8 *Nuevo Escalamiento - KamiKaze Bikes*\n\n**ID Escalamiento:** `{{ $('For Each Escalation').item.json.id }}`\n**ID Conversaci\u00f3n:** `{{ $('For Each Escalation').item.json.conversationId }}`\n**Cliente:** {{ $('GET Conversation Context').item.json.customerPhone }}\n**Raz\u00f3n:** `{{ $('For Each Escalation').item.json.reason }}`\n**Detalle:** {{ $('For Each Escalation').item.json.reasonDetail || 'N/A' }}\n**Estado:** `{{ $('For Each Escalation').item.json.status }}`\n**Creado:** {{ new Date($('For Each Escalation').item.json.createdAt).toLocaleString('es-AR') }}\n\n\ud83d\udccb **Resumen:** Un cliente necesita atenci\u00f3n humana. Revisar la conversaci\u00f3n en el panel de administraci\u00f3n.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "continueOnFail": false
