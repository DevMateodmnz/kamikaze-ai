{
  "name": "008-escalation-discord-notification",
  "nodes": [
    {
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [100, 300],
      "parameters": {}
    },
    {
      "id": "fetch-active-escalations",
      "name": "GET Active Escalations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [340, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/escalations/active",
        "options": {
          "timeout": 10000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        }
      },
      "continueOnFail": true
    },
    {
      "id": "check-escalations",
      "name": "Check Escalations Exist",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [580, 300],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "count-check",
              "leftValue": "={{ $json.escalations }}",
              "rightValue": "",
              "operator": {
                "type": "array",
                "operation": "length",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "iterate-escalations",
      "name": "For Each Escalation",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [820, 300],
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "continueOnFail": false
    },
    {
      "id": "fetch-conversation-context",
      "name": "GET Conversation Context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1100, 200],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.BACKEND_URL }}/api/v1/conversations/{{ $json.conversationId }}",
        "options": {
          "timeout": 5000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        }
      },
      "continueOnFail": true
    },
    {
      "id": "format-discord-message",
      "name": "Format Discord Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 4,
      "position": [1340, 200],
      "parameters": {
        "mode": "json",
        "assignments": {
          "assignments": [
            {
              "id": "content-field",
              "name": "content",
              "value": "=\n🚨 *Nuevo Escalamiento - KamiKaze Bikes*\n\n**ID Escalamiento:** `{{ $('For Each Escalation').item.json.id }}`\n**ID Conversación:** `{{ $('For Each Escalation').item.json.conversationId }}`\n**Cliente:** {{ $('GET Conversation Context').item.json.customerPhone }}\n**Razón:** `{{ $('For Each Escalation').item.json.reason }}`\n**Detalle:** {{ $('For Each Escalation').item.json.reasonDetail || 'N/A' }}\n**Estado:** `{{ $('For Each Escalation').item.json.status }}`\n**Creado:** {{ new Date($('For Each Escalation').item.json.createdAt).toLocaleString('es-AR') }}\n\n📋 **Resumen:** Un cliente necesita atención humana. Revisar la conversación en el panel de administración.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "continueOnFail": false
    },
    {
      "id": "send-discord-notification",
      "name": "POST Discord Webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1580, 200],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "options": {
          "timeout": 10000
        },
        "bodyParameters": {
          "parameters": [
            {
              "name": "content",
              "value": "={{ $json.content }}",
              "type": "string"
            }
          ]
        }
      },
      "continueOnFail": false
    },
    {
      "id": "mark-escalation-notified",
      "name": "PATCH Mark Notified",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1820, 200],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.BACKEND_URL }}/api/v1/escalations/{{ $('For Each Escalation').item.json.id }}/notify",
        "options": {
          "timeout": 5000
        },
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            }
          ]
        },
        "bodyParameters": {
          "parameters": []
        }
      },
      "continueOnFail": true
    },
    {
      "id": "output-summary",
      "name": "Output Summary",
      "type": "n8n-nodes-base.set",
      "typeVersion": 4,
      "position": [2060, 300],
      "parameters": {
        "mode": "json",
        "assignments": {
          "assignments": [
            {
              "id": "workflow-name",
              "name": "workflow",
              "value": "008-escalation-discord-notification",
              "type": "string"
            },
            {
              "id": "status",
              "name": "status",
              "value": "completed",
              "type": "string"
            },
            {
              "id": "timestamp",
              "name": "completedAt",
              "value": "={{ $now().toISO() }}",
              "type": "string"
            },
            {
              "id": "notified-count",
              "name": "escalationsNotified",
              "value": "={{ $('For Each Escalation').context.noItemsReturned }}",
              "type": "string"
            },
            {
              "id": "note",
              "name": "note",
              "value": "Discord notifications sent for all OPEN escalations. Escalations marked as NOTIFIED.",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "continueOnFail": false
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "GET Active Escalations",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Active Escalations": {
      "main": [
        [
          {
            "node": "Check Escalations Exist",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Escalations Exist": {
      "main": [
        [
          {
            "node": "For Each Escalation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Output Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "For Each Escalation": {
      "main": [
        [
          {
            "node": "GET Conversation Context",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "GET Conversation Context": {
      "main": [
        [
          {
            "node": "Format Discord Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Discord Message": {
      "main": [
        [
          {
            "node": "POST Discord Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "POST Discord Webhook": {
      "main": [
        [
          {
            "node": "PATCH Mark Notified",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "PATCH Mark Notified": {
      "main": [
        [
          {
            "node": "For Each Escalation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "sequential"
  },
  "staticData": null,
  "tags": ["escalation", "discord", "notification", "kamikaze-bikes"],
