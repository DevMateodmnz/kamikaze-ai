# ============================================
# Kamikaze AI — Demo Environment
# ============================================
# Copy this file to .env for the MVP company demo:
#   cp .env.demo.example .env
#
# All values are safe dummy data — no real credentials.
# The demo runs in dry-run mode: messages are processed
# but WhatsApp delivery is simulated (no Meta API call).
# ============================================

# ---- Core ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
INTERNAL_API_KEY=demo-internal-api-key-change-in-production

# ---- Database (PostgreSQL) ----
# These defaults match docker-compose.yml — no changes needed for local dev.
# If you use a different PostgreSQL instance, update accordingly.
DATABASE_URL=postgresql://kamikaze:kamikaze_dev_password@localhost:5432/kamikaze_db

# ---- WhatsApp (dry-run — no Meta credentials needed) ----
WHATSAPP_OUTBOUND_ENABLED=true
WHATSAPP_OUTBOUND_MODE=dry_run
# These are not used in dry_run mode — safe placeholders
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=demo-verify-token
WHATSAPP_API_VERSION=v21.0

# ---- AI (deterministic-only for demo — no API keys needed) ----
AI_PROVIDER=minimax
AI_CLASSIFICATION_ENABLED=false
AI_REPLIES_ENABLED=false
AI_MIN_CONFIDENCE_THRESHOLD=0.6
AI_TIMEOUT_MS=20000

# ---- Company Profile (customize for your business) ----
COMPANY_NAME=Kamikaze Bikes
COMPANY_BUSINESS_TYPE=bicicletería
COMPANY_PRODUCT_CATEGORIES=MTB, ruta, gravel, ciudad, playera
COMPANY_HOURS=Lunes a viernes de 9 a 13 y de 17 a 20. Sábados de 9 a 13.
COMPANY_LOCATION=San Miguel de Tucumán
COMPANY_PAYMENT_METHODS=Aceptamos efectivo, tarjeta de débito y crédito, MercadoPago y transferencia bancaria. Hasta 12 cuotas sin interés.
COMPANY_SHIPPING_POLICY=Hacemos envíos a todo Tucumán. Consultá con un asesor por costos y zonas de cobertura.
COMPANY_WARRANTY_POLICY=Garantía oficial del fabricante. Consultá condiciones con un asesor.

# ---- AI Provider Keys (not used when AI_CLASSIFICATION_ENABLED=false) ----
MINIMAX_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- SMTP (optional — only used when ESCALATION_EMAIL_ENABLED=true) ----
# Email notification is disabled by default (safe demo mode).
# Set ESCALATION_EMAIL_ENABLED=true and configure real SMTP to enable.
ESCALATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=demo@example.com
SMTP_PASS=demo-pass
ESCALATION_EMAIL_FROM=demo@example.com
ESCALATION_EMAIL_TO=demo@example.com
