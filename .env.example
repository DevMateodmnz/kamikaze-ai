# ============================================
# Kamikaze AI - Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

# ---- Environment ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
POSTGRES_USER=kamikaze
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kamikaze_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Backend API Key (for n8n → backend auth) ----
INTERNAL_API_KEY=change_me_to_a_secure_random_key

# ---- WhatsApp Business Cloud API ----
# Obtain from Meta Developer Console: https://developers.facebook.com/
WHATSAPP_ENABLED=false
WHATSAPP_OUTBOUND_ENABLED=false
# Delivery mode:
#   live     — real Meta WhatsApp Cloud API (requires credentials)
#   dry_run  — simulated delivery, no Meta call (for demos & local dev)
WHATSAPP_OUTBOUND_MODE=live
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_PATH=/api/v1/whatsapp/webhook

# ---- AI Gateway ----
# Primary provider: minimax | openai | gemini | anthropic | local
AI_PROVIDER=minimax
AI_FALLBACK_PROVIDER=
# AI intent classification (enabled by default)
# Set to false for deterministic-only mode (no external AI calls)
AI_CLASSIFICATION_ENABLED=true
AI_MIN_CONFIDENCE_THRESHOLD=0.6
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS_REPLY=400
AI_MAX_TOKENS_INTENT=100

# AI-generated customer-facing replies (disabled by default — safety gate)
# Enable only after prompt review, guardrails, and confidence validation
AI_REPLIES_ENABLED=false

# ---- Company Identity (Business Profile) ----
# These are non-secret data that appear in customer-facing replies.
# Override per deployment to configure for a different company.
# All values are plain text — no credentials, no DB, no multi-tenant setup.
# See docs/deployment/business-profile.md for full setup guide.
#
# When any field is left empty or commented out, the system falls back
# to legacy Kamikaze defaults to preserve backward compatibility.

COMPANY_NAME=Mi Empresa
COMPANY_BUSINESS_TYPE=comercio
COMPANY_HOURS=lunes a sábado de 9 a 13 y de 17 a 20. Domingos cerrado
COMPANY_LOCATION=San Miguel de Tucumán
COMPANY_PAYMENT_METHODS=Aceptamos efectivo, tarjeta de débito y crédito, MercadoPago y transferencia bancaria. También tenemos financiacion en hasta 12 cuotas. Consultá con un asesor para más detalles.
COMPANY_SHIPPING_POLICY=Los envíos se coordinan directamente con un asesor. Consultá por tu zona para confirmar disponibilidad y costo.
COMPANY_WARRANTY_POLICY=Consultá con un asesor sobre garantía y devoluciones.
COMPANY_PRODUCT_CATEGORIES=MTB, ruta, gravel, ciudad

# ---- AI Provider Keys ----
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE_URL=https://api.minimaxi.chat/v1

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Human Escalation (Email / SMTP) ----
# SMTP vars are optional — server starts without them.
# Set ESCALATION_EMAIL_ENABLED=true and configure all SMTP vars to enable.
ESCALATION_EMAIL_ENABLED=false
ESCALATION_EMAIL_TO=alerts@example.com
ESCALATION_EMAIL_FROM=noreply@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password_or_app_password
SMTP_SECURE=false

# ---- n8n ----
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678
# N8N_API_KEY enables programmatic workflow management via /api/v1/ endpoints.
# Generate with: openssl rand -hex 32
N8N_API_KEY=
BACKEND_URL=http://172.17.0.1:3000

# ---- Session (optional - not required for MVP Phase 0) ----
# REDIS_URL=redis://localhost:6379

# ---- Security ----
# CORS_ORIGINS=http://localhost:3000,http://localhost:5678
