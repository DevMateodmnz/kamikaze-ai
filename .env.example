# ============================================
# Kamikaze AI - Environment Variables
# ============================================
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

# ---- Environment ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---- Database (PostgreSQL) ----
POSTGRES_USER=kamikaze
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kamikaze_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Backend API Key (for n8n → backend auth) ----
INTERNAL_API_KEY=change_me_to_a_secure_random_key

# ---- WhatsApp Business Cloud API ----
# Obtain from Meta Developer Console: https://developers.facebook.com/
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
WHATSAPP_VERIFY_TOKEN=your_random_verify_token_here
WHATSAPP_API_VERSION=v21.0
WHATSAPP_WEBHOOK_PATH=/api/v1/whatsapp/webhook

# ---- AI Gateway ----
# Primary provider: minimax | openai | gemini | anthropic | local
AI_PROVIDER=minimax
AI_FALLBACK_PROVIDER=
AI_MIN_CONFIDENCE_THRESHOLD=0.6
AI_TIMEOUT_MS=20000
AI_MAX_TOKENS_REPLY=400
AI_MAX_TOKENS_INTENT=100

# ---- AI Provider Keys ----
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_API_BASE_URL=https://api.minimaxi.chat/v1

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---- Human Escalation (Discord) ----
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your/discord/webhook
ESCALATION_CHANNEL_ID=your_channel_id_here

# ---- n8n ----
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678

# ---- Session (optional - not required for MVP Phase 0) ----
# REDIS_URL=redis://localhost:6379

# ---- Security ----
# CORS_ORIGINS=http://localhost:3000,http://localhost:5678
